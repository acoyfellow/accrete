{
  "name": "accrete",
  "version": "0.0.1",
  "description": "Agents on Durable Objects build the tools they need once, then run them with no container.",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:worker": "node scripts/self-source.mjs && wrangler dev --port 8799 --var ACCRETE_TOKEN:local-dev",
    "dev:site": "vite --config client/vite.config.ts",
    "build": "cp status.json client/public/status.json && vite build --config client/vite.config.ts",
    "check": "node scripts/self-source.mjs && tsc -p . && tsc -p client",
    "lint": "biome lint",
    "gate": "bash proof/gate.sh",
    "gate:local": "ACCRETE_URL=http://localhost:8799 ACCRETE_TOKEN=local-dev bash proof/gate.sh",
    "deploy": "npm run build && wrangler deploy"
  },
  "license": "MIT",
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/containers": "^0.3.7",
    "@foldkit/vite-plugin": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "effect": "^4.0.0",
    "foldkit": "^0.168.0",
    "js-yaml": "^4.3.2",
    "marked": "^14.1.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "json5": "^2.2.3",
    "typescript": "5.9",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "private": true
}
