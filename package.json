{
  "name": "accrete",
  "version": "0.0.1",
  "description": "Agents on Durable Objects build the tools they need once, then run them with no container.",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:worker": "node scripts/self-source.mjs && wrangler dev --port ${ACCRETE_WORKER_PORT:-8797} --var ACCRETE_TOKEN:local-dev",
    "dev:site": "vite --config client/vite.config.ts",
    "build": "cp status.json client/public/status.json && node scripts/build-docs.mjs && vite build --config client/vite.config.ts",
    "check": "node scripts/self-source.mjs && tsc -p . && tsc -p client",
    "lint": "biome lint",
    "gate": "bash proof/gate.sh",
    "gate:local": "ACCRETE_URL=http://localhost:8799 ACCRETE_TOKEN=local-dev bash proof/gate.sh",
    "deploy": "npm run build && wrangler deploy",
    "bench": "bash scripts/bench-all.sh",
    "falsify": "node scripts/falsify.mjs",
    "site:numbers": "node scripts/site-numbers.mjs",
    "proof:honesty": "node scripts/honesty.mjs",
    "docs": "node scripts/build-docs.mjs",
    "bench:workflows": "node scripts/workflow-bench.mjs latest",
    "proof:adopt": "node scripts/adopt.mjs",
    "proof:scripts:live": "node scripts/scripts-proof.mjs",
    "proof:scripts": "node scripts/scripts-gate.mjs",
    "proof:ui": "node scripts/ui-states.mjs",
    "test:domain": "vitest run test/domain",
    "test:hosts": "vitest run examples/hosts/test",
    "build:browser": "esbuild examples/browser/engine.ts --bundle --platform=browser --format=esm --minify --outfile=examples/browser/dist/domain-engine.js",
    "test:hosts-local": "vitest run test/hosts"
  },
  "license": "MIT",
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/containers": "^0.3.7",
    "@foldkit/vite-plugin": "0.29.0",
    "@tailwindcss/vite": "^4.3.3",
    "effect": "4.1.4",
    "foldkit": "0.170.0",
    "js-yaml": "^4.3.2",
    "marked": "^14.1.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3",
    "@alchemy.run/domain": "2.0.0-beta.86",
    "alchemy": "2.0.0-beta.86"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "json5": "^2.2.3",
    "typescript": "5.9",
    "wrangler": "^4.149.0",
    "@effect/vitest": "4.1.4",
    "vitest": "5.1.0",
    "@alchemy.run/cloudflare": "2.0.0-beta.86",
    "@alchemy.run/effect-cluster": "2.0.0-beta.86",
    "@alchemy.run/docker": "2.0.0-beta.86",
    "@alchemy.run/aws": "2.0.0-beta.86",
    "@alchemy.run/fly": "2.0.0-beta.86",
    "@alchemy.run/gcp": "2.0.0-beta.86",
    "@alchemy.run/hetzner": "2.0.0-beta.86",
    "@alchemy.run/kubernetes": "2.0.0-beta.86",
    "@effect/sql-pg": "4.1.4",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@effect/platform-browser": "4.1.4"
  },
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "cloudflare",
    "workers",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi/index.ts"
    ]
  }
}
